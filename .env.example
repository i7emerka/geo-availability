# --- Target site ---
# Primary entry URL (geo redirect should start from here)
SITE_URL=https://fastpari.com

# --- Proxies per GEO (Playwright) ---
# One-line Dolphin/Mango format:
#   socks5://host:port:username:password
# or standard URL:
#   http://username:password@host:port
# Playwright Chromium: SOCKS5 with auth is converted to HTTP on same host:port.

UZ_PROXY_SERVER=
BD_PROXY_SERVER=
EG_PROXY_SERVER=
CI_PROXY_SERVER=

# RU by default uses your local internet (use_local_ip in config/geos.py).
# Uncomment only if you want RU via cloud proxy instead:
# RU_PROXY_SERVER=

# Optional split form:
# UZ_PROXY_SERVER=http://host:port
# UZ_PROXY_USERNAME=
# UZ_PROXY_PASSWORD=

# --- Optional: extra geos (example) ---
# KZ_PROXY_SERVER=
# TR_PROXY_SERVER=

# --- Browser ---
HEADLESS=1
NAVIGATION_TIMEOUT_MS=45000

# --- Report ---
# Set 0 to skip writing HTML after each run
WRITE_HTML_REPORT=1

# --- GitHub Pages (after each check) ---
# 1 = push reports/report.html → branch gh-pages as index.html
GITHUB_PAGES_PUBLISH=1
GITHUB_PAGES_BRANCH=gh-pages
GITHUB_PAGES_REMOTE=origin
